params {
    cluster = 'setonix'
    module_dir = '/software/projects/mwavcs/setonix/2025.08/modules/zen3/gcc/14.2.0'
    module_ver = '1.0-6celsi6'

    queue = 'mwa'
    account = 'mwavcs'

    rc_max_forks = 20
    rc_ntasks = 32
    rc_cpus_per_task = 1
    rc_mem_per_task = 2 // GB
    rc_walltime = 1 // hours
}

executor {
    $slurm {
        queueSize = 30  // Number of tasks handled in parallel
        submitRateLimit = '10 sec'  // Number of jobs submitted per second
        pollInterval = '30 sec'  // How often to poll the job status
        jobName = { "${task.process}_(${task.index})" }
    }
    $local {
        // Limit resources used on the head node
        cpus = 1
        memory = 8.GB
    }
}

process {
    cache = 'lenient'
    
    withLabel: python {
        beforeScript = "module load python/3.11.6"
    }

    withName: RECOMBINE {
        executor = 'slurm'
        queue = params.queue
        maxForks = params.rc_max_forks
        time = { params.rc_walltime * 1.h * task.attempt }
        clusterOptions = "-A ${params.account} --nodes=1 --ntasks=${params.rc_ntasks} --cpus-per-task=${params.rc_cpus_per_task} --mem=${params.rc_ntasks * params.rc_mem_per_task}G"
        beforeScript = "module use ${params.module_dir}; module load recombine/${params.module_ver}"
    }
}
